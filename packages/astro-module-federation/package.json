{
  "name": "@feedma/astro-module-federation",
  "version": "0.0.1-alpha.1",
  "description": "An Astro configuration integration for module federation",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro",
    "js",
    "typescript",
    "module",
    "federation",
    "generative",
    "ui"
  ],
  "author": "Eduardo Salazar <eduardosalazar89@hotmail.es>",
  "homepage": "https://github.com/feedma/gen-ui.module-federation-resolver#readme",
  "license": "MIT",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.umd.js"
    }
  },
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "dist",
    "test": "__tests__"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedma/gen-ui.module-federation-resolver.git"
  },
  "scripts": {
    "build": "vite build",
    "publish:local": "npm run build && npx yalc publish --push",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/feedma/gen-ui.module-federation-resolver/issues"
  },
  "dependencies": {
    "@originjs/vite-plugin-federation": "1.x",
    "astro": "5.x"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
