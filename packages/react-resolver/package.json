{
  "name": "@feedma/react-gen-ui-resolver",
  "version": "0.0.0",
  "description": "A react js version for dynamic resolution of gen ui components",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "js",
    "typescript",
    "module",
    "federation",
    "generative",
    "ui"
  ],
  "author": "Eduardo Salazar <eduardosalazar89@hotmail.es>",
  "homepage": "https://github.com/feedma/gen-ui.module-federation-resolver#readme",
  "license": "MIT",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "dist",
    "test": "__tests__"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedma/gen-ui.module-federation-resolver.git"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "publish:local": "npm run build && npx yalc publish --push",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/feedma/gen-ui.module-federation-resolver/issues"
  },
  "peerDependencies": {
    "@originjs/vite-plugin-federation": "1.x",
    "react": "19.x"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4"
  }
}
