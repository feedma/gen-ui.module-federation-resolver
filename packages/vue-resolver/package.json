{
  "name": "@feedma/vue-gen-ui-resolver",
  "version": "0.0.2-beta.1",
  "description": "A vue js version for dynamic resolution of gen ui components",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue",
    "js",
    "typescript",
    "module",
    "federation",
    "generative",
    "ui"
  ],
  "author": "Eduardo Salazar <eduardosalazar89@hotmail.es>",
  "homepage": "https://github.com/feedma/gen-ui.module-federation-resolver",
  "license": "MIT",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.umd.js"
    },
    "./DynamicRemoteComponentLoader": {
      "import": "./dist/DynamicRemoteComponentLoader.es.js",
      "require": "./dist/DynamicRemoteComponentLoader.cjs.js",
      "default": "./dist/DynamicRemoteComponentLoader.umd.js"
    }
  },
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "dist",
    "test": "__tests__"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedma/gen-ui.module-federation-resolver.git"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "publish:local": "npm run build && npx yalc publish --push",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/feedma/gen-ui.module-federation-resolver/issues"
  },
  "peerDependencies": {
    "@originjs/vite-plugin-federation": "1.x",
    "vue": "3.x"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.0.5"
  }
}
