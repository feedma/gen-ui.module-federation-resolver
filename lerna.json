{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "independent",
  "packages": ["packages/*"],
  "command": {
    "version": {
      "createRelease": "github",
      "conventionalCommits": true,
      "allowBranch": ["main", "develop", "feat", "feature", "feat-*"],
      "message": "chore(release): publish"
    },
    "publish": {
      "canary": {
        "forcePublish": true,
        "distTag": "canary"
      }
    }
  }
}
